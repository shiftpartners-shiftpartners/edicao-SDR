{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiftpartners.local/schemas/performance-observation.schema.json",
  "title": "Performance Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "creative_id", "window_start", "window_end", "timezone", "source", "currency", "metrics", "confounders", "decision", "decision_reason", "decided_by_human"],
  "properties": {
    "observation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{5,79}$"},
    "creative_id": {"type": "string", "minLength": 6},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "timezone": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "objective": {"type": ["string", "null"]},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spend": {"type": ["number", "null"], "minimum": 0},
        "impressions": {"type": ["integer", "null"], "minimum": 0},
        "reach": {"type": ["integer", "null"], "minimum": 0},
        "link_clicks": {"type": ["integer", "null"], "minimum": 0},
        "conversations_started": {"type": ["integer", "null"], "minimum": 0},
        "qualified_leads": {"type": ["integer", "null"], "minimum": 0},
        "purchases": {"type": ["integer", "null"], "minimum": 0},
        "purchase_value": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "confounders": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": ["string", "null"]},
    "decision": {"type": "string", "enum": ["scale", "iterate", "pause", "inconclusive"]},
    "decision_reason": {"type": "string", "minLength": 1},
    "decided_by_human": {"type": "boolean", "const": true}
  }
}
